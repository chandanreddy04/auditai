# Local dev (default): leave GROQ_API_KEY unset and run Ollama locally
# with `ollama pull phi3.5` - the app talks to it on localhost automatically.

# DATABASE_URL=sqlite:///./data/auditai.db   # default if unset
# On Render this is set automatically from the attached Postgres
# database (see render.yaml) - never set it manually there.

# SECRET_KEY=some-long-random-string
# Signs the session cookie (see app/services/auth_service.py /
# app/web/auth_routes.py). REQUIRED for any real deployment - the
# fallback in config.py is intentionally insecure and dev-only. Render
# generates one automatically (render.yaml: generateValue: true).

# Optional cloud LLM backend (used only when this is set - same switch
# pattern proven out in InvoiceIQ): a free Groq API key from
# https://console.groq.com/keys
# GROQ_API_KEY=
